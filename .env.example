# ─────────────────────────────────────────────────────────────────
#  AniFlow Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys as needed.
# Only required if using cloud AI services (Gemini/Claude/ElevenLabs).

# ─── Flask (optional — only matters if exposing to a network) ────
# FLASK_SECRET_KEY=change-me-to-a-random-string

# ─── AI Narration (optional — use Ollama locally instead) ────────
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here

# ─── 9router (Alternative to Ollama) ─────────────────────────────
# USE_NINE_ROUTER=1
# NINE_ROUTER_HOST=http://127.0.0.1:20128
# NINE_ROUTER_API_KEY=your_9router_api_key_here
# VISION_MODEL=Free-Tier
# WRITER_MODEL=Free-Tier
# TEXT_WRITER_MODEL=Free-Tier

# ─── Text-to-Speech (optional — use Edge TTS free or Kokoro local) ──
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── MyAnimeList Character Import (optional) ─────────────────────
# MAL_CLIENT_ID=your_mal_client_id_here
